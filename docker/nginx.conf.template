server {
    listen ${PORT};
    server_name _;
    root /var/www/html/public;
    index index.php index.html;

    charset utf-8;

    client_max_body_size 20m;

    # Long-lived cache for hashed SPA assets
    location /spa/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Laravel health check endpoint
    location = /up {
        try_files $uri /index.php?$query_string;
    }

    # Filament admin panel and Livewire traffic go to Laravel
    location ~ ^/(admin|livewire|storage)(/|$) {
        try_files $uri /index.php?$query_string;
    }

    # Public API
    location /api/v1 {
        try_files $uri /index.php?$query_string;
    }

    # SPA entry point (history-mode routing)
    location = / {
        try_files /spa/index.html =404;
    }

    # SPA with history-mode routing fallback
    location / {
        try_files $uri $uri/ /spa/index.html;
    }

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
